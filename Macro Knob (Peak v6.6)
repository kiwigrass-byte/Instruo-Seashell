-- Build once: a fast lookup of parameter numbers that belong to the mod-amount
-- macro system, so the generic snapshot machinery can skip them entirely.
-- Parameters that use non-linear/derived encoding and should not be
-- captured or restored by the generic COMPARE_IT snapshot machinery.
-- 16003 = combined master clock byte (sysEx byte 237 + bit from 238),
-- already handled independently via events.onPotTouchChange() /
-- sysExPatch writes, and its valid range does not match the raw
-- computed value in all cases.
local PATCH_PARAM_SKIP_SNAPSHOT = {
  [16003] = true,
}

local PATCH_PARAM_IS_MOD_AMOUNT = {}
for i = 1, #PATCH_PARAM_MAP do
  local parNum = PATCH_PARAM_MAP[i][3]
  if PARAM_MOD_AMOUNT_INDEX[parNum] or PATCH_PARAM_SKIP_SNAPSHOT[parNum] then
    PATCH_PARAM_IS_MOD_AMOUNT[i] = true
  end
end

local snapshotA = nil   -- table indexed same as PATCH_PARAM_MAP: value at time patch was parsed
local snapshotB = nil   -- table indexed same as PATCH_PARAM_MAP: live/edited values, captured on toggle
local comparingActive = false
local snapshotBModAmounts = nil


local function computeValueFromBytes(entry, bytes)
  local sysExByte = entry[1]
  local parKind   = entry[2]
  local value     = bytes[sysExByte]
  if parKind == 12 then
    value = 64 * (bytes[sysExByte] * 2 + getBits(bytes[sysExByte + 1], 2, 1))
  elseif sysExByte == 237 then
    value = (bytes[sysExByte] * 2 + getBits(bytes[sysExByte + 1], 2, 1))
  end
  return value
end

-- Called at the end of assignParam(), once sysExPatch has been fully parsed.
local function captureSnapshotA()
  local snap = {}
  for i = 1, #PATCH_PARAM_MAP do
    if not PATCH_PARAM_IS_MOD_AMOUNT[i] then
      snap[i] = computeValueFromBytes(PATCH_PARAM_MAP[i], sysExPatch)
    end
  end
  snapshotA = snap
  snapshotB = nil
  snapshotBModAmounts = nil

  -- Mod amounts are captured separately from the parsed parameter state,
  -- as the unscaled base reference for A.
  for i = 1, 16 do
    modAmountBase[i] = parameterMap.get(deviceId, PT_VIRTUAL, PARAM_MOD_AMOUNT[i]) or 64
  end
  macroBaseSnapshotA = copyModAmountBase(modAmountBase)
  macroBaseSnapshotB = nil

  comparingActive = false
end

local function applySnapshot(snap)
  if not snap then return end

  for i = 1, #PATCH_PARAM_MAP do
    if not PATCH_PARAM_IS_MOD_AMOUNT[i] and snap[i] ~= nil then
      local parType = PATCH_PARAM_MAP[i][2] % 10
      local parNum  = PATCH_PARAM_MAP[i][3]
      local value   = snap[i]

      local ok, err = pcall( parameterMap.set, deviceId, parType, parNum, value )

      if not ok then
        print(string.format(
          "applySnapshot: parNum=%d parType=%d value=%s rejected (%s)",
          parNum, parType, tostring(value), tostring(err)
        ))
      end
    end
  end
end

local function captureLiveAsB()
  local snap = {}
  for i = 1, #PATCH_PARAM_MAP do
    if not PATCH_PARAM_IS_MOD_AMOUNT[i] then
      local parType = PATCH_PARAM_MAP[i][2] % 10
      local parNum  = PATCH_PARAM_MAP[i][3]
      snap[i] = parameterMap.get(deviceId, parType, parNum)
    end
  end
  return snap
end

local function captureLiveModAmounts()
  local amounts = {}

  for i = 1, 16 do
    amounts[i] = parameterMap.get(
      deviceId,
      PT_VIRTUAL,
      PARAM_MOD_AMOUNT[i]
    ) or 64
  end

  return amounts
end

function compareIt(valueObject, value)
  if not snapshotA then
    print("COMPARE_IT: no patch parsed yet")
    return
  end

  compareApplying = true

  if value == 1 then
    snapshotB = captureLiveAsB()
    snapshotBModAmounts = captureLiveModAmounts()
    macroBaseSnapshotB = copyModAmountBase(modAmountBase)
    comparingActive = true

    applySnapshot(snapshotA)
    modAmountBase = copyModAmountBase(macroBaseSnapshotA)

    -- Show the true parsed patch values, ignoring locks.
    applyMacroToAll(1, true)

    print("COMPARE_IT: showing A (true patch values)")
  else
    if snapshotB then
      applySnapshot(snapshotB)
      modAmountBase = copyModAmountBase(macroBaseSnapshotB)

      -- Restore live values for locked mod amounts.
      if snapshotBModAmounts then
        for i = 1, 16 do
          local lockValue = parameterMap.get(
            deviceId,
            PT_VIRTUAL,
            PARAM_MOD_LOCK[i]
          ) or 0

          if lockValue ~= 0 then
            parameterMap.set(
              deviceId,
              PT_VIRTUAL,
              PARAM_MOD_AMOUNT[i],
              snapshotBModAmounts[i]
            )
          end
        end
      end

      -- Apply the current macro to unlocked slots only.
      applyMacroToAll()

      print("COMPARE_IT: restored B (live, current macro applied)")
    end

    comparingActive = false
  end

  compareApplying = false
end

-- ---------------- Macro amount LFO ----------------
local PARAM_MACRO_LFO = 10070
local PARAM_LFO_RATE = 10071
local PARAM_MACRO_LFO_WAVE = 10072

-- Macro LFO modes
local MACRO_LFO_OFF = 0
local MACRO_LFO_UNIPOLAR = 1
local MACRO_LFO_BIPOLAR = 2

-- Macro LFO waveforms
local MACRO_LFO_TRIANGLE = 0
local MACRO_LFO_SH = 1

-- S&H behavior
-- Maximum movement toward a new random target per cycle,
-- expressed as a fraction of the active macro range.
local MACRO_LFO_SH_MAX_STEP = 0.35

-- Portion of each S&H cycle used to glide toward the
-- new target. The remainder of the cycle holds the target.
local MACRO_LFO_SH_GLIDE_FRACTION = 0.15

local macroLfoState = {
  isRunning = false,
  phase = 0.5,

  periodMs = 4000, -- one complete cycle
  stepMs = 50,     -- timer interval

  mode = MACRO_LFO_UNIPOLAR,
  waveform = MACRO_LFO_TRIANGLE,

  -- Current normalized S&H value.
  -- 0.0 = minimum of active range
  -- 1.0 = maximum of active range
  heldRandom = 1.0,

  -- S&H interpolation values.
  shFromValue = 1.0,
  shToValue = 1.0,

  minValue = MACRO_CENTER,
  maxValue = MACRO_MAX,
}

-- ---------------- LFO utility functions ----------------

local function clamp01(value)
  if value < 0 then
    return 0
  elseif value > 1 then
    return 1
  end

  return value
end

-- Triangle waveform:
-- phase 0.0   = minimum
-- phase 0.5   = maximum
-- phase 1.0   = minimum again
local function triangleMacroValue(phase)
  local triangle

  if phase < 0.5 then
    triangle = phase * 2
  else
    triangle = 2 - phase * 2
  end

  local value =
    macroLfoState.minValue
    + triangle * (macroLfoState.maxValue - macroLfoState.minValue)

  return math.floor(value + 0.5)
end

-- Return the current S&H value mapped into the active macro range.
local function sampleAndHoldMacroValue()
  local value =
    macroLfoState.minValue
    + macroLfoState.heldRandom
      * (macroLfoState.maxValue - macroLfoState.minValue)

  return math.floor(value + 0.5)
end

local function currentMacroLfoValue()
  if macroLfoState.waveform == MACRO_LFO_SH then
    return sampleAndHoldMacroValue()
  end

  return triangleMacroValue(macroLfoState.phase)
end

-- ---------------- Correlated S&H with slew ----------------

-- Select a nearby random target.
--
-- math.random() + math.random() - 1 creates a triangular
-- distribution centered around zero. Small movements are
-- more likely than large movements.
local function chooseNextSampleAndHoldTarget()
  macroLfoState.shFromValue = macroLfoState.heldRandom

  local signedRandom = math.random() + math.random() - 1

  local newTarget =
    macroLfoState.shFromValue
    + signedRandom * MACRO_LFO_SH_MAX_STEP

  macroLfoState.shToValue = clamp01(newTarget)
end

local function updateSampleAndHoldGlide()
  local glideFraction = MACRO_LFO_SH_GLIDE_FRACTION

  if glideFraction <= 0 then
    macroLfoState.heldRandom = macroLfoState.shToValue
    return
  end

  -- Once the glide portion is complete, hold the target.
  if macroLfoState.phase >= glideFraction then
    macroLfoState.heldRandom = macroLfoState.shToValue
    return
  end

  -- Interpolate from the previous value to the new target.
  local glidePosition = macroLfoState.phase / glideFraction

  macroLfoState.heldRandom =
    macroLfoState.shFromValue
    + (macroLfoState.shToValue - macroLfoState.shFromValue)
      * glidePosition
end

-- ---------------- Apply current LFO value ----------------

local function applyCurrentMacroLfoValue()
  if comparingActive then
    return
  end

  local value = currentMacroLfoValue()

  macroKnobValue = value

  -- Keep the virtual macro control/UI synchronized.
  parameterMap.set(
    deviceId,
    PT_VIRTUAL,
    PARAM_MACRO_KNOB,
    value
  )

  -- Timer updates do not necessarily invoke the normal
  -- macro-control processing path.
  applyMacroToAll()
end

-- ---------------- Start/stop/tick ----------------

local function stopMacroLfo()
  macroLfoState.isRunning = false
  timer.disable()
  print("Macro LFO stopped")
end

local function macroLfoTick()
  if not macroLfoState.isRunning then
    return
  end

  -- Hold the LFO while COMPARE_IT is showing snapshot A.
  if comparingActive then
    return
  end

  macroLfoState.phase =
    macroLfoState.phase
    + macroLfoState.stepMs / macroLfoState.periodMs

  local wrapped = false

  if macroLfoState.phase >= 1 then
    macroLfoState.phase = macroLfoState.phase - 1
    wrapped = true
  end

  if macroLfoState.waveform == MACRO_LFO_SH then
    -- At the start of each cycle, choose a nearby new target.
    if wrapped then
      chooseNextSampleAndHoldTarget()
    end

    -- Glide toward the target, then hold it.
    updateSampleAndHoldGlide()
  end

  applyCurrentMacroLfoValue()
end

local function setMacroLfoRange(mode)
  if mode ~= MACRO_LFO_UNIPOLAR
      and mode ~= MACRO_LFO_BIPOLAR then
    mode = MACRO_LFO_UNIPOLAR
  end

  macroLfoState.mode = mode
  macroLfoState.maxValue = MACRO_MAX

  if mode == MACRO_LFO_UNIPOLAR then
    -- 100% down to 0%
    macroLfoState.minValue = MACRO_CENTER
  else
    -- 100% down to -100%
    macroLfoState.minValue = 0
  end

  print("Macro LFO range set (mode " .. tostring(mode) .. ")")
end

function startMacroLfo(mode)
  setMacroLfoRange(mode)

  if macroLfoState.isRunning then
    -- Mode changed while running. Keep the timer and phase.
    applyCurrentMacroLfoValue()
    return
  end

  macroLfoState.isRunning = true

  -- Start at 100%.
  macroLfoState.phase = 0.5

  -- Start S&H at 100% as well.
  macroLfoState.heldRandom = 1.0
  macroLfoState.shFromValue = 1.0
  macroLfoState.shToValue = 1.0

  timer.setPeriod(macroLfoState.stepMs)
  timer.enable()

  -- Apply the initial 100% value immediately.
  applyCurrentMacroLfoValue()

  print("Starting macro LFO")
end

function timer.onTick()
  if macroLfoState.isRunning then
    macroLfoTick()
  end
end

-- ---------------- Macro LFO rate control ----------------

local LFO_RATE_MIN_MS = 300
local LFO_RATE_MAX_MS = 20000

-- value: 0-255, logarithmic mapping to period in milliseconds
local function lfoRateToPeriodMs(value)
  local t = value / 255
  local logMin = math.log(LFO_RATE_MIN_MS)
  local logMax = math.log(LFO_RATE_MAX_MS)

  -- 0 = slowest, 255 = fastest
  local logPeriod = logMax + (logMin - logMax) * t

  return math.floor(math.exp(logPeriod) + 0.5)
end

function displayLfoRate(valueObject, value)
  local periodMs = lfoRateToPeriodMs(value)

  if periodMs >= 1000 then
    return string.format("%.1f s", periodMs / 1000)
  else
    return string.format("%d ms", periodMs)
  end
end

function lfoRateChange(valueObject, value)
  macroLfoState.periodMs = lfoRateToPeriodMs(value)

  print(string.format(
    "Macro LFO period set to %d ms",
    macroLfoState.periodMs
  ))
end

-- ---------------- Macro LFO waveform control ----------------

function displayMacroLfoWave(valueObject, value)
  if value == MACRO_LFO_SH then
    return "S&H"
  end

  return "Triangle"
end

function macroLfoWaveChange(valueObject, value)
  if value ~= MACRO_LFO_TRIANGLE
      and value ~= MACRO_LFO_SH then
    value = MACRO_LFO_TRIANGLE
  end

  -- If changing from triangle to S&H while running,
  -- begin from the triangle's current position to avoid
  -- an unrelated jump.
  if value == MACRO_LFO_SH
      and macroLfoState.waveform ~= MACRO_LFO_SH then

    local currentValue = triangleMacroValue(macroLfoState.phase)
    local range = macroLfoState.maxValue - macroLfoState.minValue
    local normalized = 1.0

    if range > 0 then
      normalized =
        (currentValue - macroLfoState.minValue) / range
    end

    normalized = clamp01(normalized)

    macroLfoState.heldRandom = normalized
    macroLfoState.shFromValue = normalized
    macroLfoState.shToValue = normalized
  end

  macroLfoState.waveform = value

  -- When switching to triangle, the normal triangle calculation
  -- immediately takes over. When switching to S&H, the current
  -- value is held until the next cycle boundary.
  applyCurrentMacroLfoValue()

  print(
    "Macro LFO waveform: "
    .. displayMacroLfoWave(nil, value)
  )
end

function parameterMap.onChange(valueObjects, origin, midiValue)
  -- Don't want Lua and incoming MIDI changes to enter this dispatcher.
  if origin ~= INTERNAL then return end
  local msg = valueObjects[1]:getMessage()
  local pType = msg:getType()
  local pNum = msg:getParameterNumber()
    -- Macro LFO enable toggle (0 = off, 1 = unipolar, 2 = bipolar)
  if pType == PT_VIRTUAL and pNum == PARAM_MACRO_LFO then
    if midiValue == MACRO_LFO_OFF then
      stopMacroLfo()
    else
      startMacroLfo(midiValue)
    end

    return
  end
  -- Macro LFO waveform: (0 = triangle, 1 = sample and hold
  if pType == PT_VIRTUAL and pNum == PARAM_MACRO_LFO_WAVE then
    macroLfoWaveChange(valueObjects[1], midiValue)
    return
  end
  -- Macro knob moved: rescale all 16 amounts from their bases, don't NRPN the macro itself
  if pType == PT_VIRTUAL and pNum == PARAM_MACRO_KNOB then
    macroKnobValue = math.max(0, math.min(MACRO_MAX, midiValue))
    applyMacroToAll()
    return
  end
  
  -- User (or macro) touched a mod-amount control: keep base in sync
  if pType == PT_VIRTUAL then
    local amtIdx = PARAM_MOD_AMOUNT_INDEX[pNum]

    if amtIdx and not macroApplying and not compareApplying then
      local factor = macroFactor()

      if math.abs(factor) > 0.02 then
        -- Reconstruct the unscaled base from the currently displayed amount.
        local base = 64 + (midiValue - 64) / factor

        if base < 0 then
          base = 0
        elseif base > 127 then
          base = 127
        end

        modAmountBase[amtIdx] = base
      else
      -- Near the bipolar center, the original base cannot be recovered
      -- reliably because all values are close to 64.
        modAmountBase[amtIdx] = midiValue
      end
    end
  end
  if pType == PT_VIRTUAL and pNum == PARAM_COMPARE_IT then
    compareIt(valueObjects[1], midiValue)
    return
  end
end
