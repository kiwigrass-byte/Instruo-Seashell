-- helper for converting scaled lfo rates to 0-16383 values
local function lfoScaleReverse(freq)
  -- maximum frequency is C below middle C
  local c3 = 130.81280517578125 
  -- ensure median is a frequency of 5.0 
  local l = math.log(5.0 / c3) / math.log(0.5)
  -- implied 14-bit MIDI value 
  local x = 16383*( (freq / c3)^(1.0 / l) )
  return math.floor(x + 0.5) -- Round to nearest integer
end

-- helper function to round to nearest integer
function math.round(x)
    if x >= 0 then
        return math.floor(x + 0.5)
    else
        return math.ceil(x - 0.5)
    end
end

-- helper to convert seashell preset file into table of 96 scaled parameters 
local function PM_RAW_to_PM(pm_raw)
  local pm = {}
  for value in pm_raw:gmatch('value%s*=%s*"([^"]+)"') do
    local n = tonumber(value)
    if n ~= nil then
      pm[#pm + 1] = n
    end
  end
  -- Safety check: Seashell preset should give 96 PARAM values
  if #pm ~= PARAM_NUM then
    error(("PM_RAW_to_PM: expected 96 params, got %d (input may be truncated)"):format(#pm))
  end
  -- convert non-0/1 scaled parameter values to 14-bit numbers
  pm[1]  = math.round(((1+pm[1])*16383)/2) -- -1..1
  pm[2]  = math.round(((1+pm[2])*16383)/2)
  pm[8]  = math.round(pm[8]*163.83) -- 0..100
  pm[11] = math.round(pm[11]*163.83)
  pm[12] = math.round(pm[12]*163.83)
  pm[13] = math.round(pm[13]*163.83)
  pm[14] = math.round(pm[14]*163.83)
  pm[15] = math.round(pm[15]*163.83)
  pm[18] = math.round(pm[18]*163.83) -- 0..100
  pm[19] = math.round(((100+pm[19])*16383)/200) -- -100..100
  pm[20] = math.round(pm[20]*163.83) -- 0..100
  pm[21] = math.round(pm[21]*163.83)
  pm[23] = math.round(pm[23]*1638.3) -- 0..10
  pm[24] = math.round(pm[24]*1638.3)
  pm[25] = math.round(pm[25]*163.83)
  pm[26] = math.round(pm[26]*1638.3)
  pm[34] = math.round(lfoScaleReverse(pm[34]))  -- lfo rate
  pm[39] = math.round(((180+pm[39])*16383)/360) -- -180..180
  pm[44] = math.round(lfoScaleReverse(pm[44]))  -- random rate
  pm[48] = math.round(pm[48]*163.83)
  pm[49] = math.round(pm[49]*163.83)
  pm[54] = math.round(pm[54]*163.83)
  pm[63] = math.round(((100+pm[63])*16383)/200) -- -100..100
  pm[64] = math.round(((100+pm[64])*16383)/200)
  pm[65] = math.round(((100+pm[65])*16383)/200)
  pm[66] = math.round(((100+pm[66])*16383)/200)
  pm[67] = math.round(((100+pm[67])*16383)/200)
  pm[68] = math.round(((100+pm[68])*16383)/200)
  pm[69] = math.round(((100+pm[69])*16383)/200)
  pm[70] = math.round(((100+pm[70])*16383)/200)
  pm[71] = math.round(((100+pm[71])*16383)/200)
  pm[72] = math.round(((100+pm[72])*16383)/200)
  pm[73] = math.round(((100+pm[73])*16383)/200)
  pm[74] = math.round(((100+pm[74])*16383)/200)
  pm[75] = math.round(((100+pm[75])*16383)/200)
  pm[76] = math.round(((100+pm[76])*16383)/200)
  pm[77] = math.round(((100+pm[77])*16383)/200)
  pm[78] = math.round(((100+pm[78])*16383)/200)
  pm[95] = math.round(pm[95]*163.83)
  return pm
end

-- Send a full 96-param preset (14-bit split to CC14/CC15)
local function sendPresetToSeashell(pm)
  for i = 1, #pm do
    local v = pm[i] or 0
    parameterMap.set(deviceId, PT_VIRTUAL, i - 1, v)
    local msb = math.floor(v / 128)
    local lsb = v % 128
    midi.sendControlChange(port, 14, i - 1, msb)
    midi.sendControlChange(port, 15, i - 1, lsb)
    dprint(("CC14/15 sent: controller=%d msb=%d lsb=%d"):format(i - 1, msb, lsb))
  end
end

-- Value formatter for the preset selector control label
function formatPresetName(valueObject, value)
  local idx = math.floor(tonumber(value) or -1)
  local p = PRESETS[idx]
  if p then
    return p.name
  end
  return "Preset " .. tostring(value)
end

-- set parameters and send CCs to reset mod matrix to match init patch
function resetIt(valueObject,value)
  if value == 0 then return end
  local preset = PRESETS[0]
  if not preset then
    dprint("RESET_IT: unknown preset index " .. tostring(value))
    return
  end
  local pm = PM_RAW_to_PM(preset.raw)
  for i = 55, 94 do
    local v = pm[i] or 0
    parameterMap.set(deviceId, PT_VIRTUAL, i - 1, v)
    local msb = math.floor(v / 128)
    local lsb = v % 128
    midi.sendControlChange(port, 14, i - 1, msb)
    midi.sendControlChange(port, 15, i - 1, lsb)
    dprint(("CC14/15 sent: controller=%d msb=%d lsb=%d"):format(i - 1, msb, lsb))
  end
  dprint("Reset Mod Matrix")
end

--------- block to handle sync of random rate/notes to lfo rate/notes ---------------------

-- guard to avoid re-entrant loops when we set RND_RATE from inside onChange
local syncingRndToLfo = false

-- if sync is enabled, force RND mode/value to follow LFO mode/value
local function applyRndLfoSync()
  if syncingRndToLfo then return end
  local sync = parameterMap.get(deviceId, PT_VIRTUAL, SYNC_TO_LFO) or 0
  if sync ~= 1 then return end
  syncingRndToLfo = true
  -- LFO mode dominates
  local lfoMode = parameterMap.get(deviceId, PT_VIRTUAL, LFO_RATE_TYPE) or 0
  local rndMode = parameterMap.get(deviceId, PT_VIRTUAL, RND_RATE_TYPE) or 0
  -- 1) align RND mode to LFO mode
  if rndMode ~= lfoMode then
    parameterMap.set(deviceId, PT_VIRTUAL, RND_RATE_TYPE, lfoMode)
  end
  -- 2) align value in the active mode
  if lfoMode == 1 then
    -- note-sync mode: copy LFO_NOTE -> RND_NOTE
    local lfoNote = parameterMap.get(deviceId, PT_VIRTUAL, LFO_NOTE) or 0
    local rndNote = parameterMap.get(deviceId, PT_VIRTUAL, RND_NOTE) or -1
    if rndNote ~= lfoNote then
      parameterMap.set(deviceId, PT_VIRTUAL, RND_NOTE, lfoNote)
    end
  else
    -- free-rate mode: copy LFO_RATE -> RND_RATE
    local lfoRate = parameterMap.get(deviceId, PT_VIRTUAL, LFO_RATE) or 0
    local rndRate = parameterMap.get(deviceId, PT_VIRTUAL, RND_RATE) or -1
    if rndRate ~= lfoRate then
      parameterMap.set(deviceId, PT_VIRTUAL, RND_RATE, lfoRate)
    end
  end
  syncingRndToLfo = false
end

------------------ COMPARE_IT toggle block -----------------------------------
-- value 1: cache edited state (B), recall unedited baseline (A)
-- value 0: recall cached edited state (B)
-- comparison state (A/B)
-- A = unedited loaded patch snapshot
-- B = cached edited snapshot
local compareEditedPM   = nil
local compareUneditedPM = nil

-- Capture current 96 PT_VIRTUAL params from Electra
local function snapshotCurrentPM()
  local pm = {}
  for i = 1, PARAM_NUM do
    pm[i] = parameterMap.get(deviceId, PT_VIRTUAL, i - 1) or 0
  end
  return pm
end

local function clonePM(src)
  if not src then return nil end
  local dst = {}
  for i = 1, #src do dst[i] = src[i] end
  return dst
end

local compareLatched = false

function compareIt(valueObject, value)
  local v = math.floor(tonumber(value) or 0)

  if v == 1 then
    if not compareLatched then
      if not compareUneditedPM then
        compareUneditedPM = snapshotCurrentPM()
      end
      compareEditedPM = snapshotCurrentPM()

      dprint(("COMPARE cache set; p1=%d p2=%d p34=%d"):format(
        compareEditedPM[1] or -1, compareEditedPM[2] or -1, compareEditedPM[34] or -1
      ))

      compareLatched = true
    end

    sendPresetToSeashell(compareUneditedPM)
    applyRndLfoSync()       -- <- enforce lock for recalled A state
    showRNDRate(nil, nil)   -- <- keep UI consistent (optional but recommended)
    dprint("COMPARE_IT=1 -> showing unedited patch")
    return
  end

  if v == 0 then
    if compareLatched and compareEditedPM then
      sendPresetToSeashell(compareEditedPM)
      applyRndLfoSync()       -- <- enforce lock for recalled B state
      showRNDRate(nil, nil)   -- <- keep UI consistent (optional but recommended)
      dprint("COMPARE_IT=0 -> restored edited patch")
    else
      dprint("COMPARE_IT=0 -> no cached edited patch to restore")
    end
    compareLatched = false
    return
  end
end

-------------------- Patch selector on knob release ----------------------------------

-- curCtl holds which of the control knobs was touched (HT @oldgearguy)
local curCtl   = -1

-- helper function to find match between touched control and target list of controls
local function get_key_for_value(t, value) 
   if (t ~= nil) then
      for k,v in pairs(t) do
         if v==value then return k end
      end
   end
   return nil
end

function events.onPotTouchChange(potId, controlId, touched)
--  if not touched then return end
  local help = HELP_TEXTS[controlId]
  if help then showHelp(help) end

  local idx = get_key_for_value(CTRL_SELECT_IT,controlId)
  if (idx == nil) then return end
  if (touched == true) and (curCtl ~= controlId) then curCtl = controlId end
  if (touched == false) and (curCtl == controlId) then
    local value = controls.get(controlId):getValue("value"):getMessage():getValue()
    local index = math.floor(tonumber(value) or -1)
    local preset = PRESETS[index]
    if not preset then
      dprint("SELECT_IT: unknown preset index " .. tostring(value))
      return
    end
    local pm = PM_RAW_to_PM(preset.raw)
    if #pm ~= PARAM_NUM then
      dprint(("SELECT_IT: '%s' has %d params (expected 96)"):format(preset.name, #pm))
      return
    end
    -- send patch parameter values to Seashell
    sendPresetToSeashell(pm)

    -- send a program change to the Seashell as well (so Seashell app also stays in sync)
    midi.sendProgramChange(port, channel, index)

    -- enforce LFO->RND lock if SYNC_TO_LFO is enabled in the loaded preset
    applyRndLfoSync()

    -- always refresh RND visibility after patch load
    showRNDRate(nil, nil)

    -- refresh compare baseline to newly loaded preset (unedited A state)
    compareUneditedPM = clonePM(pm)
    compareEditedPM   = nil
    parameterMap.set(deviceId, PT_VIRTUAL, COMPARE_IT, 0)

    dprint(("Loaded preset %d => %s"):format(idx, preset.name))  end
end

-- parameterMap on change callback
function parameterMap.onChange(valueObjects, origin, midiValue)
  if (origin ~= INTERNAL) then return end
  local msg = valueObjects[1]:getMessage()
  if msg:getType() ~= PT_VIRTUAL then return end
  local pNum = msg:getParameterNumber()

  -- keep RND_RATE locked to LFO_RATE when sync is enabled
  if pNum == SYNC_TO_LFO or pNum == LFO_RATE_TYPE
  or pNum == LFO_RATE or pNum == LFO_NOTE
  then
    applyRndLfoSync()
  end

  if pNum == SYNC_TO_LFO or pNum == RND_RATE_TYPE then
    showRNDRate(nil, nil)
  end

  -- send MSB/LSB CC messages for new MIDI value
  local msb_value = math.floor(midiValue/128)
  local lsb_value = midiValue%128
  if pNum < 128 then
    midi.sendControlChange(port, 14, pNum, msb_value)
    midi.sendControlChange(port, 15, pNum, lsb_value)
    dprint("CC14 sent:" .. " controllerNumber=" .. pNum .. " msb value=" .. msb_value .. " lsb value=" .. lsb_value )
  end
end

