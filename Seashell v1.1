local CTRL_LFO_NOTE = 42
local CTRL_RND_RATE = 92
local CTRL_RND_NOTE = 93
local CTRL_DECAY_TIME = 4
local CTRL_SUSTAIN_LEVEL = 5
local CTRL_SYNC_TO_LFO = 99
local CTRL_RND_RATE_TYPE = 91

-- Generic helper for two controls where one is the inverse of the other.
local function setPairVisibility(firstControlId, secondControlId, showFirst)
  controls.get(firstControlId):setVisible(showFirst)
  controls.get(secondControlId):setVisible(not showFirst)
end

-- display/hide lfo rate and note sync
function showLFORate(valueObject, value)
  local mode = parameterMap.get(deviceId, PT_VIRTUAL, LFO_RATE_TYPE)
  local isSync = (mode == 1)
  setPairVisibility(CTRL_LFO_NOTE, CTRL_LFO_RATE, isSync)
end

-- display/hide decay time and sustain level
function showADSR(valueObject, value)
  local mode = parameterMap.get(deviceId, PT_VIRTUAL, ENV_MODE)
  local show = (mode == 1)
  controls.get(CTRL_DECAY_TIME):setVisible(show)
  controls.get(CTRL_SUSTAIN_LEVEL):setVisible(show)
end

-- display/hide random rate and note sync
function showRNDRate(valueObject, value)
  local rndMode   = parameterMap.get(deviceId, PT_VIRTUAL, RND_RATE_TYPE) or 0
  local syncToLfo = (parameterMap.get(deviceId, PT_VIRTUAL, SYNC_TO_LFO) or 0) == 1
  if syncToLfo then
    -- LFO is master: hide all RND timing controls
    controls.get(CTRL_RND_RATE_TYPE):setVisible(false)
    controls.get(CTRL_RND_RATE):setVisible(false)
    controls.get(CTRL_RND_NOTE):setVisible(false)
    return
  end
  -- normal (independent) mode: show type selector and the active value control
  controls.get(CTRL_RND_RATE_TYPE):setVisible(true)
  setPairVisibility(CTRL_RND_NOTE, CTRL_RND_RATE, rndMode == 1)
end

-- Add % sign
function addPercentage (valueObject, value)
    return (string.format ("%d%%", value))
end

function percent(valueObject,value) ---- 
  return string.format ("%d %%", math.floor(100*value/16383))
end

-- -1 to + 1
function oscFreq(valueObject,value)
  return string.format ("%.2f", (2*value/16383 - 1))
end

-- -100 to + 100
function attenuverter(valueObject,value)
  return string.format ("%d %%", math.floor((200*value/16383 - 100)))
end

-- -180 to + 180
function phase(valueObject,value)
  return string.format ("%.1f deg", math.floor((360*value/16383 - 180)))
end

function time(valueObject,value)
  return string.format ("%.2f s", (10*value/16383))
end

-- Convert number to a range with decimal numbers
function convertToFractions (valueObject, value)
    return (string.format("%.1f", value / 20))
end

-- convert 0..16383 MIDI values to Seashell's lfo rate scale
function lfoScale(valueObject,value)
  -- scale t0 [0,1]
  local r = value/16383
  -- maximum frequency is C below middle C
  local c3 = 130.81280517578125 
  -- ensure median is a frequency of 5.0 
  local l = math.log(5.0 / c3) / math.log(0.5)
  -- frequency displayed
  local f = c3 * r^l
  if r == 0 then
    return (string.format("%.2f", 0) .. " Hz")
  elseif r == 1 then  
    return (string.format("%.2f", 131) .. " Hz")
  else
    return (string.format("%.2f", f) .. " Hz")
  end
end

function syncToLFO(valueObject,value)
  if value == nil then return end
--  local lfoSync = parameterMap.get(deviceId, PT_VIRTUAL, SYNC_TO_LFO)
  if value == 1 then
    local lfoRate = parameterMap.get(deviceId, PT_VIRTUAL, LFO_RATE)
    parameterMap.set(deviceId, PT_VIRTUAL, RND_RATE, lfoRate)
  end
end

-- ── AHDSR value-in-name suffix ───────────────────────────────────────────────
-- Appends the live value of an AHDSR envelope's primary stage to its tile
-- title, e.g. "AMP ATTACK" -> "AMP ATTACK 101". The base (unsuffixed) name is
-- captured the first time each control is seen so repeat updates don't keep
-- stacking suffixes onto an already-modified name.

local adsrBaseNames = setmetatable({}, {__mode = "k"})

function adsrValueName(valueObject, value)
  local ctrl = valueObject:getControl()
  --if not ctrl then return end
  local id = ctrl:getId()
  if not adsrBaseNames[id] then adsrBaseNames[id] = ctrl:getName() end
  if id ~= 5 then
    ctrl:setName(adsrBaseNames[id] .. " " .. string.format("%.2f s", (10*value/16383)))
  elseif id == 5 then
    ctrl:setName(adsrBaseNames[id] .. " " .. string.format("%d %%", math.floor(100*value/16383)))
  end
  -- print ("ctl = "..id..", base Name = "..ahdsrBaseNames[id])
end

