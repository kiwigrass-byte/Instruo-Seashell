  if msg:getType() ~= PT_VIRTUAL then return end
  local pNum = msg:getParameterNumber()
  if pNum == 1002 then -- initialize
    if midiValue == 1 then
      for i = 1,#INITIAL do
      parameterMap.set(deviceId, PT_VIRTUAL, i-1, INITIAL.value[i])
      end
