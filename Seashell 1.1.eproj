ode\" value=\"0.0\"/><PARAM id=\"lfomode\" value=\"0.0\"/><PARAM id=\"lfopolarity\" value=\"0.0\"/><PARAM id=\"lfophase\" value=\"0.0\"/><PARAM id=\"lfotriggerbutton\" value=\"1.0\"/><PARAM id=\"lfotriggerjack\" value=\"1.0\"/><PARAM id=\"lfotriggernoteon\" value=\"1.0\"/><PARAM id=\"rndlforatesync\" value=\"1.0\"/><PARAM id=\"rndrate\" value=\"5.000000476837158\"/><PARAM id=\"rndratesubdivision\" value=\"9.0\"/><PARAM id=\"rndtimemode\" value=\"0.0\"/><PARAM id=\"rndpolarity\" value=\"0.0\"/><PARAM id=\"rnddensity\" value=\"100.0\"/><PARAM id=\"rndsmoothing\" value=\"0.0\"/><PARAM id=\"rndtriggerbutton\" value=\"0.0\"/><PARAM id=\"rndtriggerjack\" value=\"0.0\"/><PARAM id=\"rndtriggernoteon\" value=\"0.0\"/><PARAM id=\"taptempoenable\" value=\"1.0\"/><PARAM id=\"macro\" value=\"57.27278137207031\"/><PARAM id=\"mxsource1\" value=\"14.0\"/><PARAM id=\"mxsource2\" value=\"2.0\"/><PARAM id=\"mxsource3\" value=\"0.0\"/><PARAM id=\"mxsource4\" value=\"0.0\"/><PARAM id=\"mxdesta\" value=\"14.0\"/><PARAM id=\"mxdestb\" value=\"25.0\"/><PARAM id=\"mxdestc\" value=\"0.0\"/><PARAM id=\"mxdestd\" value=\"0.0\"/><PARAM id=\"mxnode1a\" value=\"80.5\"/><PARAM id=\"mxnode1b\" value=\"0.0\"/><PARAM id=\"mxnode1c\" value=\"0.0\"/><PARAM id=\"mxnode1d\" value=\"0.0\"/><PARAM id=\"mxnode2a\" value=\"0.0\"/><PARAM id=\"mxnode2b\" value=\"42.99996948242188\"/><PARAM id=\"mxnode2c\" value=\"0.0\"/><PARAM id=\"mxnode2d\" value=\"0.0\"/><PARAM id=\"mxnode3a\" value=\"0.0\"/><PARAM id=\"mxnode3b\" value=\"0.0\"/><PARAM id=\"mxnode3c\" value=\"0.0\"/><PARAM id=\"mxnode3d\" value=\"0.0\"/><PARAM id=\"mxnode4a\" value=\"0.0\"/><PARAM id=\"mxnode4b\" value=\"0.0\"/><PARAM id=\"mxnode4c\" value=\"0.0\"/><PARAM id=\"mxnode4d\" value=\"0.0\"/><PARAM id=\"mxnode1alock\" value=\"0.0\"/><PARAM id=\"mxnode1block\" value=\"0.0\"/><PARAM id=\"mxnode1clock\" value=\"0.0\"/><PARAM id=\"mxnode1dlock\" value=\"0.0\"/><PARAM id=\"mxnode2alock\" value=\"0.0\"/><PARAM id=\"mxnode2block\" value=\"0.0\"/><PARAM id=\"mxnode2clock\" value=\"0.0\"/><PARAM id=\"mxnode2dlock\" value=\"0.0\"/><PARAM id=\"mxnode3alock\" value=\"0.0\"/><PARAM id=\"mxnode3block\" value=\"0.0\"/><PARAM id=\"mxnode3clock\" value=\"0.0\"/><PARAM id=\"mxnode3dlock\" value=\"0.0\"/><PARAM id=\"mxnode4alock\" value=\"0.0\"/><PARAM id=\"mxnode4block\" value=\"0.0\"/><PARAM id=\"mxnode4clock\" value=\"0.0\"/><PARAM id=\"mxnode4dlock\" value=\"0.0\"/><PARAM id=\"monitormix\" value=\"100.0\"/><PARAM id=\"pickupbehaviour\" value=\"0.0\"/><Quantiser program=\"0\"/></Parameters><Notes text=\"\"/></SeashellPreset> \r\n]]\r\n\r\n-- Preset table\r\nlocal PRESETS = {\r\n  [0] = { name = \"Initial\",   raw = INITIAL_RAW },\r\n  [1] = { name = \"Deep Bass\", raw = DEEP_BASS_RAW },\r\n  [2] = { name = \"Ow Bass\",   raw = OW_BASS_RAW },\r\n  [3] = { name = \"Uber Drone\",  raw = UBER_DRONE_RAW },\r\n  [4] = { name = \"Wub Wub\",   raw = WUB_WUB_RAW },\r\n  [5] = { name = \"Apocolypse Strings\", raw = APOCOLYPSE_STRINGS_RAW },\r\n  [6] = { name = \"Boards of Fanada\", raw = BOARDS_OF_FANADA_RAW },\r\n  [7] = { name = \"Buzz Saw\", raw = BUZZ_SAW_RAW },\r\n  [8] = { name = \"Sad String\", raw = SAD_STRING_RAW },\r\n  [9] = { name = \"Soup or Saw\", raw = SOUP_OR_SAW_RAW },\r\n  [10] = { name = \"Sync Bender\", raw = SYNC_BENDER_RAW },\r\n  [11] = { name = \"Tone Bender\", raw = TONE_BENDER_RAW },\r\n  [12] = { name = \"Doppler\", raw = DOPPLER_RAW },\r\n  [13] = { name = \"Kitchen Sync\", raw = KITCHEN_SYNC_RAW },\r\n  [14] = { name = \"Pulse with Mod\", raw = PULSE_WITH_MOD_RAW },\r\n  [15] = { name = \"Saw 5ths\", raw = SAW_5THS_RAW },\r\n  [16] = { name = \"Sync Sweep\", raw = SYNC_SWEEP_RAW },\r\n  [17] = { name = \"Unraveled\", raw = UNRAVELED_RAW },\r\n  [18] = { name = \"Dmaj Gen Duophonic\", raw = DMAJ_DUOPHONIC_RAW },\r\n  [19] = { name = \"Frodo\", raw = FRODO_RAW },\r\n  [20] = { name = \"Montage\", raw = MONTAGE_RAW },\r\n  [21] = { name = \"Rando Calrissian\", raw = RANDO_CALRISSIAN_RAW },\r\n  [22] = { name = \"Kick\", raw = KICK_RAW },\r\n  [23] = { name = \"Snare\", raw = SNARE_RAW },\r\n  [24] = { name = \"Sourdrum Starter\", raw = SOURDRUM_STARTER_RAW },\r\n  [25] = { name = \"Stone Table\", raw = STONE_TABLE_RAW },\r\n  [26] = { name = \"Brassy\", raw = BRASSY_RAW },\r\n  [27] = { name = \"Chip Tune\", raw = CHIP_TUNE_RAW },\r\n  [28] = { name = \"Octave Pluck\", raw = OCTAVE_PLUCK_RAW },\r\n  [29] = { name = \"One Octave Trill\", raw = ONE_OCTAVE_TRILL_RAW },\r\n  [30] = { name = \"Pink Echoes\", raw = PINK_ECHOES_RAW },\r\n  [31] = { name = \"Pluck Short\", raw = PLUCK_SHORT_RAW },\r\n  [32] = { name = \"Popcorn\", raw = POPCORN_RAW },\r\n  [33] = { name = \"Saw Slapback\", raw = SAW_SLPABACK_RAW },\r\n  [34] = { name = \"Shine On\", raw = SHINE_ON_RAW },\r\n  [35] = { name = \"Tremelo\", raw = TREMELO_RAW },\r\n  [36] = { name = \"ACME Ray Gun\", raw = ACME_RAY_GUN_RAW },\r\n  [37] = { name = \"Kurtz\", raw = KURTZ_RAW },\r\n  [38] = { name = \"Red Alert\", raw = RED_ALERT_RAW },\r\n  [39] = { name = \"Ring Ring\", raw = RING_RING_RAW },\r\n  [40] = { name = \"Sound of the Future\", raw = SOUND_OF_THE_FUTURE_RAW },\r\n}\r\n\r\n-- helper for converting scaled lfo rates to 0-16383 values\r\nlocal function lfoScaleReverse(freq)\r\n  -- maximum frequency is C below middle C\r\n  local c3 = 130.81280517578125 \r\n  -- ensure median is a frequency of 5.0 \r\n  local l = math.log(5.0 / c3) / math.log(0.5)\r\n  -- implied 14-bit MIDI value \r\n  local x = 16383*( (freq / c3)^(1.0 / l) )\r\n  return math.floor(x + 0.5) -- Round to nearest integer\r\nend\r\n\r\n-- helper function to round to nearest integer\r\nfunction math.round(x)\r\n    if x >= 0 then\r\n        return math.floor(x + 0.5)\r\n    else\r\n        return math.ceil(x - 0.5)\r\n    end\r\nend\r\n\r\n-- helper to convert seashell preset file into table of 96 scaled parameters \r\nlocal function PM_RAW_to_PM(pm_raw)\r\n  local pm = {}\r\n  for value in pm_raw:gmatch('value%s*=%s*\"([^\"]+)\"') do\r\n    local n = tonumber(value)\r\n    if n ~= nil then\r\n      pm[#pm + 1] = n\r\n    end\r\n  end\r\n  -- Safety check: Seashell preset should give 96 PARAM values\r\n  if #pm ~= PARAM_NUM then\r\n    error((\"PM_RAW_to_PM: expected 96 params, got %d (input may be truncated)\"):format(#pm))\r\n  end\r\n  -- convert non-0/1 scaled parameter values to 14-bit numbers\r\n  pm[1]  = math.round(((1+pm[1])*16383)/2) -- -1..1\r\n  pm[2]  = math.round(((1+pm[2])*16383)/2)\r\n  pm[8]  = math.round(pm[8]*163.83) -- 0..100\r\n  pm[11] = math.round(pm[11]*163.83)\r\n  pm[12] = math.round(pm[12]*163.83)\r\n  pm[13] = math.round(pm[13]*163.83)\r\n  pm[14] = math.round(pm[14]*163.83)\r\n  pm[15] = math.round(pm[15]*163.83)\r\n  pm[18] = math.round(pm[18]*163.83) -- 0..100\r\n  pm[19] = math.round(((100+pm[19])*16383)/200) -- -100..100\r\n  pm[20] = math.round(pm[20]*163.83) -- 0..100\r\n  pm[21] = math.round(pm[21]*163.83)\r\n  pm[23] = math.round(pm[23]*1638.3) -- 0..10\r\n  pm[24] = math.round(pm[24]*1638.3)\r\n  pm[25] = math.round(pm[25]*163.83)\r\n  pm[26] = math.round(pm[26]*1638.3)\r\n  pm[34] = math.round(lfoScaleReverse(pm[34]))  -- lfo rate\r\n  pm[39] = math.round(((180+pm[39])*16383)/360) -- -180..180\r\n  pm[44] = math.round(lfoScaleReverse(pm[44]))  -- random rate\r\n  pm[48] = math.round(pm[48]*163.83)\r\n  pm[49] = math.round(pm[49]*163.83)\r\n  pm[54] = math.round(pm[54]*163.83)\r\n  pm[63] = math.round(((100+pm[63])*16383)/200) -- -100..100\r\n  pm[64] = math.round(((100+pm[64])*16383)/200)\r\n  pm[65] = math.round(((100+pm[65])*16383)/200)\r\n  pm[66] = math.round(((100+pm[66])*16383)/200)\r\n  pm[67] = math.round(((100+pm[67])*16383)/200)\r\n  pm[68] = math.round(((100+pm[68])*16383)/200)\r\n  pm[69] = math.round(((100+pm[69])*16383)/200)\r\n  pm[70] = math.round(((100+pm[70])*16383)/200)\r\n  pm[71] = math.round(((100+pm[71])*16383)/200)\r\n  pm[72] = math.round(((100+pm[72])*16383)/200)\r\n  pm[73] = math.round(((100+pm[73])*16383)/200)\r\n  pm[74] = math.round(((100+pm[74])*16383)/200)\r\n  pm[75] = math.round(((100+pm[75])*16383)/200)\r\n  pm[76] = math.round(((100+pm[76])*16383)/200)\r\n  pm[77] = math.round(((100+pm[77])*16383)/200)\r\n  pm[78] = math.round(((100+pm[78])*16383)/200)\r\n  pm[95] = math.round(pm[95]*163.83)\r\n  return pm\r\nend\r\n\r\n-- Send a full 96-param preset (14-bit split to CC14/CC15)\r\nlocal function sendPresetToSeashell(pm)\r\n  for i = 1, #pm do\r\n    local v = pm[i] or 0\r\n    parameterMap.set(deviceId, PT_VIRTUAL, i - 1, v)\r\n    local msb = math.floor(v / 128)\r\n    local lsb = v % 128\r\n    midi.sendControlChange(port, 14, i - 1, msb)\r\n    midi.sendControlChange(port, 15, i - 1, lsb)\r\n    dprint((\"CC14/15 sent: controller=%d msb=%d lsb=%d\"):format(i - 1, msb, lsb))\r\n  end\r\nend\r\n\r\n-- Value formatter for the preset selector control label\r\nfunction formatPresetName(valueObject, value)\r\n  local idx = math.floor(tonumber(value) or -1)\r\n  local p = PRESETS[idx]\r\n  if p then\r\n    return p.name\r\n  end\r\n  return \"Preset \" .. tostring(value)\r\nend\r\n\r\n-- set parameters and send CCs to reset modo matrix to match init patch\r\nfunction resetIt(valueObject,value)\r\n  if value == 0 then return end\r\n  local preset = PRESETS[0]\r\n  if not preset then\r\n    dprint(\"RESET_IT: unknown preset index \" .. tostring(value))\r\n    return\r\n  end\r\n  local pm = PM_RAW_to_PM(preset.raw)\r\n  for i = 55, 94 do\r\n    local v = pm[i] or 0\r\n    parameterMap.set(deviceId, PT_VIRTUAL, i - 1, v)\r\n    local msb = math.floor(v / 128)\r\n    local lsb = v % 128\r\n    midi.sendControlChange(port, 14, i - 1, msb)\r\n    midi.sendControlChange(port, 15, i - 1, lsb)\r\n    dprint((\"CC14/15 sent: controller=%d msb=%d lsb=%d\"):format(i - 1, msb, lsb))\r\n  end\r\n  dprint(\"Reset Mod Matrix\")\r\nend\r\n\r\n-- block to handle sync of random rate/notes to lfo rate/notes\r\n-- guard to avoid re-entrant loops when we set RND_RATE from inside onChange\r\nlocal syncingRndToLfo = false\r\n\r\n-- if sync is enabled, force RND mode/value to follow LFO mode/value\r\nlocal function applyRndLfoSync()\r\n  if syncingRndToLfo then return end\r\n  local sync = parameterMap.get(deviceId, PT_VIRTUAL, SYNC_TO_LFO) or 0\r\n  if sync ~= 1 then return end\r\n  syncingRndToLfo = true\r\n  -- LFO mode dominates\r\n  local lfoMode = parameterMap.get(deviceId, PT_VIRTUAL, LFO_RATE_TYPE) or 0\r\n  local rndMode = parameterMap.get(deviceId, PT_VIRTUAL, RND_RATE_TYPE) or 0\r\n  -- 1) align RND mode to LFO mode\r\n  if rndMode ~= lfoMode then\r\n    parameterMap.set(deviceId, PT_VIRTUAL, RND_RATE_TYPE, lfoMode)\r\n  end\r\n  -- 2) align value in the active mode\r\n  if lfoMode == 1 then\r\n    -- note-sync mode: copy LFO_NOTE -> RND_NOTE\r\n    local lfoNote = parameterMap.get(deviceId, PT_VIRTUAL, LFO_NOTE) or 0\r\n    local rndNote = parameterMap.get(deviceId, PT_VIRTUAL, RND_NOTE) or -1\r\n    if rndNote ~= lfoNote then\r\n      parameterMap.set(deviceId, PT_VIRTUAL, RND_NOTE, lfoNote)\r\n    end\r\n  else\r\n    -- free-rate mode: copy LFO_RATE -> RND_RATE\r\n    local lfoRate = parameterMap.get(deviceId, PT_VIRTUAL, LFO_RATE) or 0\r\n    local rndRate = parameterMap.get(deviceId, PT_VIRTUAL, RND_RATE) or -1\r\n    if rndRate ~= lfoRate then\r\n      parameterMap.set(deviceId, PT_VIRTUAL, RND_RATE, lfoRate)\r\n    end\r\n  end\r\n  syncingRndToLfo = false\r\nend\r\n\r\n-- COMPARE_IT toggle\r\n-- value 1: cache edited state (B), recall unedited baseline (A)\r\n-- value 0: recall cached edited state (B)\r\n\r\n-- Capture current 96 PT_VIRTUAL params from Electra\r\nlocal function snapshotCurrentPM()\r\n  local pm = {}\r\n  for i = 1, PARAM_NUM do\r\n    pm[i] = parameterMap.get(deviceId, PT_VIRTUAL, i - 1) or 0\r\n  end\r\n  return pm\r\nend\r\n\r\nlocal function clonePM(src)\r\n  if not src then return nil end\r\n  local dst = {}\r\n  for i = 1, #src do dst[i] = src[i] end\r\n  return dst\r\nend\r\n\r\nlocal compareLatched = false\r\n\r\nfunction compareIt(valueObject, value)\r\n  local v = math.floor(tonumber(value) or 0)\r\n\r\n  if v == 1 then\r\n    if not compareLatched then\r\n      if not compareUneditedPM then\r\n        compareUneditedPM = snapshotCurrentPM()\r\n      end\r\n      compareEditedPM = snapshotCurrentPM()\r\n\r\n      dprint((\"COMPARE cache set; p1=%d p2=%d p34=%d\"):format(\r\n        compareEditedPM[1] or -1, compareEditedPM[2] or -1, compareEditedPM[34] or -1\r\n      ))\r\n\r\n      compareLatched = true\r\n    end\r\n\r\n    sendPresetToSeashell(compareUneditedPM)\r\n    applyRndLfoSync()       -- <- enforce lock for recalled A state\r\n    showRNDRate(nil, nil)   -- <- keep UI consistent (optional but recommended)\r\n    dprint(\"COMPARE_IT=1 -> showing unedited patch\")\r\n    return\r\n  end\r\n\r\n  if v == 0 then\r\n    if compareLatched and compareEditedPM then\r\n      sendPresetToSeashell(compareEditedPM)\r\n      applyRndLfoSync()       -- <- enforce lock for recalled B state\r\n      showRNDRate(nil, nil)   -- <- keep UI consistent (optional but recommended)\r\n      dprint(\"COMPARE_IT=0 -> restored edited patch\")\r\n    else\r\n      dprint(\"COMPARE_IT=0 -> no cached edited patch to restore\")\r\n    end\r\n    compareLatched = false\r\n    return\r\n  end\r\nend\r\n\r\n-- parameterMap on change callback\r\nfunction parameterMap.onChange(valueObjects, origin, midiValue)\r\n  if (origin ~= INTERNAL) then return end\r\n  local msg = valueObjects[1]:getMessage()\r\n  if msg:getType() ~= PT_VIRTUAL then return end\r\n  local pNum = msg:getParameterNumber()\r\n\r\n  -- keep RND_RATE locked to LFO_RATE when sync is enabled\r\nif pNum == SYNC_TO_LFO or pNum == LFO_RATE_TYPE\r\n  or pNum == LFO_RATE or pNum == LFO_NOTE\r\n  then\r\n    applyRndLfoSync()\r\n  end\r\n\r\n  if pNum == SYNC_TO_LFO or pNum == RND_RATE_TYPE then\r\n    showRNDRate(nil, nil)\r\n  end\r\n\r\n  local msb_value = math.floor(midiValue/128)\r\n  local lsb_value = midiValue%128\r\n  if pNum < 128 then\r\n    midi.sendControlChange(port, 14, pNum, msb_value)\r\n    midi.sendControlChange(port, 15, pNum, lsb_value)\r\n    dprint(\"CC14 sent:\" .. \" controllerNumber=\" .. pNum .. \" msb value=\" .. msb_value .. \" lsb value=\" .. lsb_value )\r\n  end\r\nend\r\n\r\n-- helper function to find match between touched control and target list of controls\r\nlocal function get_key_for_value(t, value) \r\n   if (t ~= nil) then\r\n      for k,v in pairs(t) do\r\n         if v==value then return k end\r\n      end\r\n   end\r\n   return nil\r\nend\r\n\r\n-- Patch selector on release\r\nfunction events.onPotTouchChange(potId, controlId, touched)\r\n--  if not touched then return end\r\n  local help = HELP_TEXTS[controlId]\r\n  if help then showHelp(help) end\r\n\r\n  local idx = get_key_for_value(CTRL_SELECT_IT,controlId)\r\n  if (idx == nil) then return end\r\n  if (touched == true) and (curCtl ~= controlId) then curCtl = controlId end\r\n  if (touched == false) and (curCtl == controlId) then\r\n    local value = controls.get(controlId):getValue(\"value\"):getMessage():getValue()\r\n    local index = math.floor(tonumber(value) or -1)\r\n    local preset = PRESETS[index]\r\n    if not preset then\r\n      dprint(\"SELECT_IT: unknown preset index \" .. tostring(value))\r\n      return\r\n    end\r\n    local pm = PM_RAW_to_PM(preset.raw)\r\n    if #pm ~= PARAM_NUM then\r\n      dprint((\"SELECT_IT: '%s' has %d params (expected 96)\"):format(preset.name, #pm))\r\n      return\r\n    end\r\n    sendPresetToSeashell(pm)\r\n\r\n    -- enforce LFO->RND lock if SYNC_TO_LFO is enabled in the loaded preset\r\n    applyRndLfoSync()\r\n\r\n    -- always refresh RND visibility after patch load\r\n    showRNDRate(nil, nil)\r\n\r\n    -- refresh compare baseline to newly loaded preset (unedited A state)\r\n    compareUneditedPM = clonePM(pm)\r\n    compareEditedPM   = nil\r\n    parameterMap.set(deviceId, PT_VIRTUAL, COMPARE_IT, 0)\r\n\r\n    dprint((\"Loaded preset %d => %s\"):format(idx, preset.name))  end\r\nend\r\n","devices":[{"id":1,"name":"Current Device","instrumentId":"generic-controls","port":1,"channel":2}],"tiles":[{"id":"deb49612-3f5c-4e8b-a4dd-e7141c5085d8","reference":38,"type":"label","name":"COARSE TUNING","color":"F49500","span":1,"vspan":2},{"id":"ad2b014a-9eff-4ec1-9661-a4b0ae5ebf8d","reference":15,"type":"label","name":"WaveFOLDER","color":"F49500","variant":"","span":4,"vspan":1},{"id":"baa9af22-b966-4209-9971-74b98cef8779","reference":16,"type":"label","name":"WAVEFORMS","color":"F49500","variant":"","span":1,"vspan":1},{"id":"2c649a5e-7375-4540-9747-a2f8f64a4d46","reference":1,"type":"fader","deviceId":1,"color":"F49500","name":"OSC 1 FREQ","values":[{"message":{"type":"virtual","deviceId":1,"parameterNumber":0,"min":0,"max":16383},"defaultValue":8192,"formatter":"oscFreq"}],"visible":true,"variant":"thin","mode":""},{"id":"915264ab-8860-4460-b931-bb0cd99006a8","reference":7,"type":"fader","deviceId":1,"color":"F49500","name":"Fold Depth","values":[{"message":{"type":"virtual","deviceId":1,"parameterNumber":10,"min":0,"max":16383},"defaultValue":8192,"formatter":"percent"}],"visible":true,"variant":"thin","mode":""},{"id":"bcaf3c59-af6d-477f-bd0a-11d95f5f8a4a","reference":10,"type":"fader","deviceId":1,"color":"F49500","name":"Fold Bias","values":[{"message":{"type":"virtual","deviceId":1,"parameterNumber":11,"min":0,"max":16383},"defaultValue":0,"formatter":"percent"}],"visible":true,"variant":"thin","mode":""},{"id":"0bdd212c-a71a-4dca-8ad4-d9d1ab242112","reference":12,"type":"list","deviceId":1,"color":"F49500","name":"Fold Shape","values":[{"message":{"type":"virtual","deviceId":1,"parameterNumber":9},"textValues":[{"value":1,"label":"Sine"},{"value":2,"label":"Sawtooth"}]}],"visible":true},{"id":"fb004991-899c-401c-ac14-f4f205644ef7","reference":28,"type":"fader","deviceId":1,"color":"F49500","name":"FOLD ANIMATE","values":[{"message":{"type":"virtual","deviceId":1,"parameterNumber":12,"min":0,"max":16383},"defaultValue":8192,"formatter":"